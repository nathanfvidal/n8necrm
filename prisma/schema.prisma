generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GESTOR
  VENDEDOR
}

enum LeadChannel {
  FORMULARIO
  WHATSAPP
  MANUAL
}

// Fatia 1 do atendente de WhatsApp (ver plano em .superpowers/sdd/whatsapp-fatia-1).
enum WhatsappDirecao {
  ENTRADA
  SAIDA
}

// CLIENTE só aparece em mensagens ENTRADA. IA e HUMANO só aparecem em SAIDA —
// HUMANO não tem nenhum caminho de código que o grave ainda (Fatia 2, "o
// humano assume"), mas o valor já existe no enum agora para não exigir uma
// migração de enum quando essa fatia chegar.
enum WhatsappAutor {
  CLIENTE
  IA
  HUMANO
}

// Tipo de conteúdo da mensagem, como a Evolution reporta em `messageType`.
// Só TEXTO é de fato respondido nesta fatia — os demais são registrados
// (para o inbox mostrar que a mensagem chegou) e recebem uma resposta de
// fallback única em vez de processamento real (ver turno.ts).
enum WhatsappTipo {
  TEXTO
  AUDIO
  IMAGEM
  DOCUMENTO
  STICKER
  OUTRO
}

model User {
  id                 String         @id @default(cuid())
  nome               String
  email              String         @unique
  senhaHash          String
  papel              Role
  ativo              Boolean        @default(true)
  criadoEm           DateTime       @default(now())
  leadsAtribuidos    Lead[]         @relation("LeadResponsavel")
  tasks              Task[]
  notes              LeadNote[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  conversasPausadas  Conversation[] @relation("ConversasPausadas")
  botConfigsEditadas BotConfig[]    @relation("BotConfigsEditadas")
}

model Contact {
  id            String         @id @default(cuid())
  nome          String
  telefone      String         @unique
  email         String?
  criadoEm      DateTime       @default(now())
  leads         Lead[]
  conversations Conversation[]
}

model PipelineStage {
  id        String  @id @default(cuid())
  nome      String
  ordem     Int
  cor       String
  ehGanho   Boolean @default(false)
  ehPerdido Boolean @default(false)
  leads     Lead[]

  @@unique([ordem])
}

// TRÊS COLUNAS RESERVADAS, sem código que as leia ou escreva hoje: `itemId`,
// `sessionId` e `utm`. Não são resíduo de refatoração — nasceram na migração
// inicial para a Fase 2 do roteiro antigo (catálogo + site mostruário), que foi
// abandonada. Ver `docs/superpowers/specs/2026-08-07-nucleo-e-modulos-sob-demanda.md`
// § 5.
//
// Ficam porque são nuláveis, sem chave estrangeira e sem índice: removê-las
// custaria uma migração para resolver problema nenhum. Se o rastreio de origem
// voltar, `sessionId` e `utm` servem a qualquer vertical (não só a catálogo) e
// são a parte reaproveitável daquele plano; `itemId` só faz sentido junto com
// um módulo `catalog` que ainda não existe.
//
// Antes de usar qualquer uma delas, leia a § 5 daquela spec: elas foram
// desenhadas para um fluxo específico (visitante anônimo → evento → lead) e
// reaproveitar sem esse contexto é como herdar significado que nunca existiu.
model Lead {
  id                String         @id @default(cuid())
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id])
  itemId            String?
  stageId           String
  stage             PipelineStage  @relation(fields: [stageId], references: [id])
  responsavelId     String?
  responsavel       User?          @relation("LeadResponsavel", fields: [responsavelId], references: [id])
  canal             LeadChannel
  valorEstimado     Decimal?
  sessionId         String?
  utm               Json?
  criadoEm          DateTime       @default(now())
  ultimaInteracaoEm DateTime       @default(now())
  notes             LeadNote[]
  tasks             Task[]
  conversations     Conversation[]

  @@index([stageId, responsavelId])
  @@index([criadoEm])
}

model LeadNote {
  id       String   @id @default(cuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId  String
  autor    User     @relation(fields: [autorId], references: [id])
  texto    String
  criadoEm DateTime @default(now())
}

model Task {
  id            String    @id @default(cuid())
  titulo        String
  descricao     String?
  vencimento    DateTime
  concluidaEm   DateTime?
  responsavelId String
  responsavel   User      @relation(fields: [responsavelId], references: [id])
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  criadoEm      DateTime  @default(now())
}

model Notification {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  tipo     String
  payload  Json
  lidaEm   DateTime?
  criadoEm DateTime  @default(now())

  // Task 19: listarNotificacoesNaoLidas (core/notifications/dispatch.ts) e o
  // sino de PainelNav consultam exatamente este par em toda navegação sob
  // (painel)/layout.tsx — ver o comentário lá sobre a decisão de custo.
  @@index([userId, lidaEm])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  acao       String
  entidade   String
  entidadeId String
  antes      Json?
  depois     Json?
  ip         String?
  criadoEm   DateTime @default(now())
}

model RateLimit {
  chave        String   @id
  janelaInicio DateTime
  contagem     Int      @default(0)
}

/**
 * Uma conversa de WhatsApp com um número (waId). `contactId`/`leadId` ficam
 * nulos até alguém (Fatia 2) criar/associar um lead a partir dela — o
 * atendimento por IA desta fatia não depende de nenhum dos dois existirem.
 * `telefone` só é gravado quando `src/modules/whatsapp/telefone.ts` (a
 * versão que NÃO lança de `normalizarTelefone`) reconhece o número como
 * brasileiro; `waId` (o identificador bruto que a Evolution manda, sem o
 * sufixo "@s.whatsapp.net") é sempre gravado, mesmo quando `telefone` fica
 * nulo — ver a decisão "Telefone" no plano da Fatia 1.
 * `bufferSeq` e `processandoAte` implementam o buffer de fragmentos + lease
 * de processamento descritos no plano (§ "O problema central e sua
 * solução"): `bufferSeq` é incrementado atomicamente a cada mensagem ENTRADA
 * ingerida (ver ingest.ts) e comparado contra o `seq` do job de fila em
 * turno.ts para saber se chegou mensagem mais nova desde que o job foi
 * enfileirado; `processandoAte` é o lease em si (NULL = livre, timestamp no
 * futuro = ocupado até lá), tomado com o mesmo idioma de UPDATE condicional
 * atômico que `checarRateLimit` (core/rate-limit/limiter.ts) já usa.
 */
model Conversation {
  id             String            @id @default(cuid())
  waId           String            @unique
  telefone       String?
  contactId      String?
  contact        Contact?          @relation(fields: [contactId], references: [id])
  leadId         String?
  lead           Lead?             @relation(fields: [leadId], references: [id])
  nomeExibicao   String?
  bufferSeq      Int               @default(0)
  processandoAte DateTime?
  criadoEm       DateTime          @default(now())
  atualizadoEm   DateTime          @updatedAt
  mensagens      WhatsappMessage[]
  iaAtiva        Boolean           @default(true)
  iaPausadaEm    DateTime?
  iaPausadaPorId String?
  iaPausadaPor   User?             @relation("ConversasPausadas", fields: [iaPausadaPorId], references: [id])

  // turno.ts faz UPDATE ... WHERE "processandoAte" IS NULL OR "processandoAte" < now()
  // a cada job de fila — sem índice, essa checagem varreria a tabela inteira
  // conforme o número de conversas ativas cresce.
  @@index([processandoAte])
}

/// Configuração do agente de IA — LINHA ÚNICA, id fixo `bot-config`.
///
/// A unicidade é imposta pelo banco, não por convenção: `id` tem valor default
/// constante, então um segundo `create` sem id explícito colide na chave
/// primária. Nenhum código precisa perguntar "qual das linhas é a certa".
///
/// Semeada por `prisma/seed.ts` a partir de `config/bot.ts`. Em runtime a
/// verdade é ESTA tabela — `config/bot.ts` só é lido pelo seed e pela ação
/// explícita de restaurar ao padrão do fork, nunca no caminho de resposta ao
/// cliente.
model BotConfig {
  id              String   @id @default("bot-config")
  ativo           Boolean  @default(true)
  personaNome     String
  personaPapel    String
  regras          String[]
  faq             String   @default("")
  atualizadoEm    DateTime @updatedAt
  atualizadoPorId String?
  atualizadoPor   User?    @relation("BotConfigsEditadas", fields: [atualizadoPorId], references: [id])
}

/**
 * Uma mensagem individual (recebida ou enviada) dentro de uma `Conversation`.
 * `idExterno` é o id que a Evolution atribui à mensagem (`data.key.id` no
 * payload do webhook) — é a chave de idempotência que faz uma redelivery do
 * mesmo webhook (retry da própria Evolution, ou reenvio manual) não duplicar
 * a mensagem no banco: `ingest.ts` trata a violação dessa constraint UNIQUE
 * exatamente como `encontrarOuCriarContact` trata a corrida em
 * `Contact.telefone` (core/leads/dedupe.ts) — "alguém já gravou isso,
 * devolve sem duplicar" em vez de deixar o erro cru do Postgres subir.
 * `processadoEm` marca quando esta mensagem ENTRADA foi incluída numa
 * resposta gerada por `turno.ts` — mensagens SAIDA já nascem com
 * `processadoEm` preenchido (não esperam processamento). É o que permite
 * `turno.ts` buscar exatamente as mensagens ainda não respondidas a cada
 * turno, mesmo quando várias chegaram fragmentadas antes do lease abrir.
 */
model WhatsappMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  idExterno      String          @unique
  direcao        WhatsappDirecao
  autor          WhatsappAutor
  tipo           WhatsappTipo
  texto          String?
  processadoEm   DateTime?
  criadoEm       DateTime        @default(now())

  // turno.ts filtra por (conversationId, direcao=ENTRADA, processadoEm=null)
  // a cada job — mesmo raciocínio do índice em Conversation.processandoAte.
  @@index([conversationId, direcao, processadoEm])
}
