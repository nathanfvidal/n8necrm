generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GESTOR
  VENDEDOR
}

enum LeadChannel {
  FORMULARIO
  WHATSAPP
  MANUAL
}

// Fatia 1 do atendente de WhatsApp (ver plano em .superpowers/sdd/whatsapp-fatia-1).
enum WhatsappDirecao {
  ENTRADA
  SAIDA
}

// CLIENTE só aparece em mensagens ENTRADA. IA e HUMANO só aparecem em SAIDA —
// HUMANO não tem nenhum caminho de código que o grave ainda (Fatia 2, "o
// humano assume"), mas o valor já existe no enum agora para não exigir uma
// migração de enum quando essa fatia chegar.
enum WhatsappAutor {
  CLIENTE
  IA
  HUMANO
}

// Tipo de conteúdo da mensagem, como a Evolution reporta em `messageType`.
// Só TEXTO é de fato respondido nesta fatia — os demais são registrados
// (para o inbox mostrar que a mensagem chegou) e recebem uma resposta de
// fallback única em vez de processamento real (ver turno.ts).
enum WhatsappTipo {
  TEXTO
  AUDIO
  IMAGEM
  DOCUMENTO
  STICKER
  OUTRO
}

// NÃO recebe `companyId`. A mesma pessoa pode ter `Membership` em VÁRIAS
// empresas (ADMIN na própria, VENDEDOR na de um cliente que ela atende) —
// empresa é atributo do VÍNCULO, não da pessoa. `email` continua único
// GLOBALMENTE, de propósito: é o mesmo login em qualquer empresa a que a
// pessoa esteja vinculada.
//
// `papel` foi derrubada e RESTAURADA na mesma tarefa (Ciclo 1a, Task 2 parte
// 2, migração `20260819140000_restaura_user_papel_temporariamente`). O DROP
// passou na verificação de integridade, mas o `typecheck` do repositório
// inteiro revelou um terceiro grupo de leitores que nem o plano original nem
// esta tarefa previram — `src/core/audit/alerta.ts` (produção: destinatários
// do alerta de rajada destrutiva) e ~20 arquivos de teste/e2e. Corrigi-los é
// decisão de escopo fora do que esta tarefa estava autorizada a tomar
// sozinha (o brief manda PARAR e reportar ao achar um terceiro leitor não
// previsto). `core/users/service.ts` grava nas DUAS colunas (`User.papel` e
// `Membership.papel`) enquanto este bridge existir — ver comentário lá.
model User {
  id                 String         @id @default(cuid())
  nome               String
  email              String         @unique
  senhaHash          String
  /// Espelho depreciado. A fonte de verdade do papel é `Membership.papel`
  /// (ver comentário do modelo `Membership` acima) — esta coluna sobrevive
  /// só por dual-write, escrita em paralelo a cada mudança de papel, e
  /// NENHUMA decisão de autorização a lê: as 15 chamadas de `hasPermission`
  /// em `src/` recebem o usuário de `usuarioAtual()`/`usuarioAtualOuLogin()`,
  /// que resolve o papel pelo vínculo, verificado em 2026-08-19.
  ///
  /// Por que ela ainda existe: três tentativas de derrubá-la em 2026-08-19
  /// descobriram três grupos de leitores diferentes cada vez; a medição
  /// final encontrou `papel` referenciado em ~80 arquivos, entre
  /// componentes, páginas, testes e e2e. Derrubar a coluna é varredura
  /// mecânica desses ~80 pontos, um ciclo próprio — não passo de tarefa
  /// avulsa, e por isso não foi feito aqui.
  ///
  /// Código novo lê o papel de `Membership`, nunca daqui.
  papel              Role
  ativo              Boolean        @default(true)
  criadoEm           DateTime       @default(now())
  leadsAtribuidos    Lead[]         @relation("LeadResponsavel")
  tasks              Task[]
  notes              LeadNote[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  conversasPausadas  Conversation[] @relation("ConversasPausadas")
  botConfigsEditadas BotConfig[]    @relation("BotConfigsEditadas")
  memberships        Membership[]
  configsEditadas    CompanyConfig[] @relation("ConfigsEditadas")
}

/// A empresa — fronteira de tenancy. Cada linha de dado de tenant (`Contact`,
/// `Lead`, etc.) pertence a exatamente uma `Company`, via `companyId`.
///
/// Ciclo 1a mantém a UI servindo uma empresa só (decisão 4 do spec de
/// tenancy: "sem seletor, sem tela de empresas") — este modelo existe para
/// que o BANCO já imponha a fronteira antes de a aplicação ganhar uma tela
/// que crie a segunda empresa.
model Company {
  id           String   @id @default(cuid())
  nome         String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  memberships      Membership[]
  contacts         Contact[]
  pipelineStages   PipelineStage[]
  leads            Lead[]
  leadNotes        LeadNote[]
  tasks            Task[]
  notifications    Notification[]
  conversations    Conversation[]
  whatsappMessages WhatsappMessage[]
  auditLogs        AuditLog[]
  // `BotConfig?`, não `BotConfig[]`: `@@unique([companyId])` em BotConfig
  // torna a relação 1-para-1 aos olhos do Prisma.
  botConfig        BotConfig?
  // `CompanyConfig?` pelo mesmo motivo, e pela mesma constraint — ver o bloco
  // do modelo, logo depois de `BotConfig`.
  config           CompanyConfig?
}

/// Vínculo entre pessoa e empresa, e é ONDE O PAPEL VIVE.
///
/// Papel é relação, não atributo: a mesma pessoa pode ser ADMIN na própria
/// empresa e VENDEDOR na de um cliente que ela atende. Enquanto `papel` era
/// coluna de `User`, isso era inexprimível.
///
/// `@@unique([userId, companyId])` porque dois vínculos da mesma pessoa com a
/// mesma empresa não significam nada — e permitir isso faria a resolução de
/// "qual papel?" depender de qual linha o banco devolvesse primeiro.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  papel     Role
  criadoEm  DateTime @default(now())

  @@unique([userId, companyId])
  // `usuarioAtual()` busca por userId em toda requisição.
  @@index([userId])
  @@index([companyId])
}

model Contact {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  nome      String
  telefone  String  @unique
  email     String?

  // ─── Cadastro de pessoa ───────────────────────────────────────────────
  //
  // Colunas fixas, e não uma tabela de campos configuráveis: decisão do dono.
  // O caminho configurável foi desenhado e descartado — `config` continha uma
  // chave `entidade.campos` que prometia exatamente isso e que nenhum código
  // lia.
  empresa String?
  cargo   String?

  // NÃO é `@unique`, de propósito. A unicidade de `telefone` existe porque o
  // dedupe de leads depende dela, e já custa um ramo inteiro de tratamento de
  // P2002 em `contacts/service.ts`. Nada no sistema deduplica por documento —
  // uma constraint aqui só criaria um modo de falha novo (dois cadastros
  // legítimos com o mesmo CNPJ de matriz, por exemplo) sem servir a ninguém.
  documento String?

  // Endereço em três colunas, não em sete com CEP/número/complemento. `cidade`
  // separada é a única que paga o próprio custo: permite "leads por cidade"
  // depois sem migração. O resto é texto livre até alguém precisar de mais.
  endereco String?
  cidade   String?
  uf       String? @db.Char(2)

  observacoes String?

  criadoEm     DateTime @default(now())
  // `@updatedAt`: o Prisma carimba sozinho a cada `update`. Fazer isso na mão
  // no serviço significa que a próxima escrita esquecida deixa a coluna
  // mentindo — e uma coluna de auditoria que mente é pior que não existir.
  // A migração faz o backfill a partir de `criadoEm`; ver o SQL para o porquê.
  //
  // `@default(now())` NÃO é redundante com `@updatedAt`, e a diferença já
  // custou uma quebra: banco e aplicação não são publicados juntos. A migração
  // roda antes do deploy, e entre um e outro o código ANTIGO continua
  // inserindo sem esta coluna. Sem default, `NOT NULL` derruba todo
  // `INSERT` de contato nessa janela — inclusive `encontrarOuCriarContact`,
  // por onde passa a criação de lead. Medido em produção, não deduzido:
  // `null value in column "atualizadoEm" violates not-null constraint`.
  atualizadoEm DateTime @default(now()) @updatedAt

  leads         Lead[]
  conversations Conversation[]
  tasks         Task[]

  // Ordenação padrão da agenda (`listarContatos`, `criadoEm desc`). NÃO há
  // índice de busca aqui: `ILIKE '%termo%'` não é servido por btree, e a
  // ferramenta certa (`pg_trgm` + GIN) o Prisma não representa — viraria drift
  // em todo `migrate diff`. Gatilho para reabrir: a agenda passar de alguns
  // milhares de linhas e a busca ficar lenta de verdade, medida.
  @@index([criadoEm])
  @@index([companyId])
}

model PipelineStage {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  nome      String
  ordem     Int
  cor       String
  ehGanho   Boolean @default(false)
  ehPerdido Boolean @default(false)
  leads     Lead[]

  // `@@unique([ordem])` continua GLOBAL, não `[companyId, ordem]`, de
  // propósito NESTA tarefa: virar composta exigiria auditar cada consulta que
  // hoje confia em `ordem` ser única sozinha (`core/pipeline/service.ts`), e
  // essa é a classe de mudança que este ciclo empurra para depois — a UI
  // continua servindo uma empresa só (decisão 4 do spec de tenancy), então
  // nada quebra HOJE. Fica registrado como achado no relatório desta tarefa:
  // é bloqueador para a SEGUNDA empresa existir, não para esta.
  @@unique([ordem])
  @@index([companyId])
}

// TRÊS COLUNAS RESERVADAS, sem código que as leia ou escreva hoje: `itemId`,
// `sessionId` e `utm`. Não são resíduo de refatoração — nasceram na migração
// inicial para a Fase 2 do roteiro antigo (catálogo + site mostruário), que foi
// abandonada. Ver `docs/superpowers/specs/2026-08-07-nucleo-e-modulos-sob-demanda.md`
// § 5.
//
// Ficam porque são nuláveis, sem chave estrangeira e sem índice: removê-las
// custaria uma migração para resolver problema nenhum. Se o rastreio de origem
// voltar, `sessionId` e `utm` servem a qualquer vertical (não só a catálogo) e
// são a parte reaproveitável daquele plano; `itemId` só faz sentido junto com
// um módulo `catalog` que ainda não existe.
//
// Antes de usar qualquer uma delas, leia a § 5 daquela spec: elas foram
// desenhadas para um fluxo específico (visitante anônimo → evento → lead) e
// reaproveitar sem esse contexto é como herdar significado que nunca existiu.
model Lead {
  id                String         @id @default(cuid())
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id])
  contactId         String?
  contact           Contact?       @relation(fields: [contactId], references: [id])
  itemId            String?
  stageId           String
  stage             PipelineStage  @relation(fields: [stageId], references: [id])
  responsavelId     String?
  responsavel       User?          @relation("LeadResponsavel", fields: [responsavelId], references: [id])
  canal             LeadChannel
  // `@db.Decimal(14, 2)`: sem precisão declarada, o Prisma usa o padrão do
  // Postgres — `numeric(65, 30)`, que aceita 30 casas decimais, ou seja
  // frações de centavo. Dinheiro tem exatamente duas.
  valorEstimado     Decimal?       @db.Decimal(14, 2)
  sessionId         String?
  utm               Json?
  criadoEm          DateTime       @default(now())
  ultimaInteracaoEm DateTime       @default(now())
  // `arquivadoEm` (null = ativo) em vez de `ativo Boolean`, e coluna em vez de
  // uma etapa "Arquivado" no funil: uma etapa manteria o lead DENTRO do funil,
  // aparecendo no kanban e somando no painel — o oposto do que arquivar serve.
  // Guarda *quando*, seguindo `Task.concluidaEm`.
  //
  // TODA listagem de lead filtra por esta coluna. Ver `core/leads/queries.ts`.
  arquivadoEm       DateTime?
  notes             LeadNote[]
  tasks             Task[]
  conversations     Conversation[]

  @@index([stageId, responsavelId])
  @@index([criadoEm])
  @@index([arquivadoEm])
  @@index([companyId])
}

model LeadNote {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  leadId    String
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  autorId   String
  autor     User      @relation(fields: [autorId], references: [id])
  texto     String
  criadoEm  DateTime  @default(now())
  // Marca que o texto foi corrigido depois de escrito. Sem isto o histórico
  // mente por omissão: o texto muda e nada indica que mudou.
  editadoEm DateTime?

  // As DUAS colunas, não só `leadId`: `listarNotas` filtra por lead E ordena
  // por `criadoEm desc`, e um índice composto serve as duas coisas na mesma
  // varredura — com só `leadId`, o Postgres encontra as linhas e depois
  // ordena à parte. Nesta escala a diferença não é mensurável, e o PR deve
  // dizer isso em vez de fingir ganho: é seguro barato numa tabela que só
  // cresce.
  @@index([leadId, criadoEm])
  @@index([companyId])
}

model Task {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  titulo        String
  descricao     String?
  vencimento    DateTime
  concluidaEm   DateTime?
  responsavelId String
  responsavel   User      @relation(fields: [responsavelId], references: [id])
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  // `Restrict` e NÃO o `SetNull` que o Prisma usaria por padrão numa relação
  // opcional — por isso é explícito. Não existe exclusão de contato na
  // aplicação hoje; no dia em que existir, `SetNull` faria "ligar para a
  // Fernanda às 15h" perder a Fernanda em silêncio, e a tarefa continuaria
  // na lista apontando para ninguém. `Restrict` transforma isso num erro que
  // alguém precisa resolver de propósito. Custo hoje: zero.
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: Restrict)
  criadoEm      DateTime  @default(now())

  // `Task` não tinha índice NENHUM. Seja honesto sobre o motivo: nesta escala
  // nenhum dos dois é mensurável — é seguro barato numa tabela de escrita
  // baixa, posto agora porque o filtro de concluídas passa a consultar por
  // `concluidaEm` em toda listagem.
  //
  // A ordem das colunas não é arbitrária: o Postgres serve igualdade
  // (`responsavelId`, `concluidaEm`) e ordenação (`vencimento`) no MESMO
  // índice, desde que as colunas de igualdade venham primeiro.
  //
  // NÃO existe `Task_contactId_idx` de propósito: nada consulta tarefa por
  // contato nesta branch, e índice sem consulta é peso morto na escrita.
  @@index([responsavelId, concluidaEm, vencimento])
  @@index([leadId, concluidaEm])
  @@index([companyId])
}

model Notification {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tipo      String
  payload   Json
  lidaEm    DateTime?
  criadoEm  DateTime  @default(now())

  // Task 19: listarNotificacoesNaoLidas (core/notifications/dispatch.ts) e o
  // sino de PainelNav consultam exatamente este par em toda navegação sob
  // (painel)/layout.tsx — ver o comentário lá sobre a decisão de custo.
  @@index([userId, lidaEm])
  @@index([companyId])
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  acao       String
  entidade   String
  entidadeId String
  antes      Json?
  depois     Json?
  ip         String?
  criadoEm   DateTime @default(now())

  // Serve o detector de rajada destrutiva (`core/audit/alerta.ts`), que roda a
  // cada ação sensível, e cobre de quebra a chave estrangeira `userId`, que era
  // a única do CRM sem índice numa tabela que só cresce. Igualdade antes de
  // faixa: `userId = ?` depois `criadoEm >= ?`.
  @@index([userId, criadoEm])
  @@index([companyId])
}

model RateLimit {
  chave        String   @id
  janelaInicio DateTime
  contagem     Int      @default(0)
}

/**
 * Uma conversa de WhatsApp com um número (waId). `contactId`/`leadId` ficam
 * nulos até alguém (Fatia 2) criar/associar um lead a partir dela — o
 * atendimento por IA desta fatia não depende de nenhum dos dois existirem.
 * `telefone` só é gravado quando `src/modules/whatsapp/telefone.ts` (a
 * versão que NÃO lança de `normalizarTelefone`) reconhece o número como
 * brasileiro; `waId` (o identificador bruto que a Evolution manda, sem o
 * sufixo "@s.whatsapp.net") é sempre gravado, mesmo quando `telefone` fica
 * nulo — ver a decisão "Telefone" no plano da Fatia 1.
 * `bufferSeq` e `processandoAte` implementam o buffer de fragmentos + lease
 * de processamento descritos no plano (§ "O problema central e sua
 * solução"): `bufferSeq` é incrementado atomicamente a cada mensagem ENTRADA
 * ingerida (ver ingest.ts) e comparado contra o `seq` do job de fila em
 * turno.ts para saber se chegou mensagem mais nova desde que o job foi
 * enfileirado; `processandoAte` é o lease em si (NULL = livre, timestamp no
 * futuro = ocupado até lá), tomado com o mesmo idioma de UPDATE condicional
 * atômico que `checarRateLimit` (core/rate-limit/limiter.ts) já usa.
 */
model Conversation {
  id                    String            @id @default(cuid())
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id])
  waId                  String            @unique
  telefone              String?
  contactId             String?
  contact               Contact?          @relation(fields: [contactId], references: [id])
  leadId                String?
  lead                  Lead?             @relation(fields: [leadId], references: [id])
  nomeExibicao          String?
  bufferSeq             Int               @default(0)
  processandoAte        DateTime?
  criadoEm              DateTime          @default(now())
  atualizadoEm          DateTime          @updatedAt
  mensagens             WhatsappMessage[]
  iaAtiva               Boolean           @default(true)
  iaPausadaEm           DateTime?
  iaPausadaPorId        String?
  iaPausadaPor          User?             @relation("ConversasPausadas", fields: [iaPausadaPorId], references: [id])
  aguardandoHumanoDesde DateTime?

  // turno.ts faz UPDATE ... WHERE "processandoAte" IS NULL OR "processandoAte" < now()
  // a cada job de fila — sem índice, essa checagem varreria a tabela inteira
  // conforme o número de conversas ativas cresce.
  @@index([processandoAte])
  // A lista de conversas ordena por este campo em toda navegação para
  // /conversas — mesmo raciocínio do índice em `processandoAte`.
  @@index([aguardandoHumanoDesde])
  @@index([companyId])
}

/// Configuração do agente de IA — uma linha POR EMPRESA.
///
/// Era linha única, id fixo `bot-config`: um segundo `create` sem id
/// explícito colidia na chave primária, e nenhum código precisava perguntar
/// "qual das linhas é a certa". Config por empresa quebra esse truque —
/// passariam a existir várias linhas legítimas, uma por `companyId`. A
/// unicidade continua imposta pelo BANCO, não por convenção: agora é
/// `@@unique([companyId])` em vez de PK constante — uma config por empresa,
/// pelo mesmo motivo, por outro caminho.
///
/// Semeada por `prisma/seed.ts` a partir de `config/bot.ts`. Em runtime a
/// verdade é ESTA tabela — `config/bot.ts` só é lido pelo seed e pela ação
/// explícita de restaurar ao padrão do fork, nunca no caminho de resposta ao
/// cliente.
model BotConfig {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  ativo           Boolean  @default(true)
  personaNome     String
  personaPapel    String
  regras          String[]
  faq             String   @default("")
  atualizadoEm    DateTime @updatedAt
  atualizadoPorId String?
  atualizadoPor   User?    @relation("BotConfigsEditadas", fields: [atualizadoPorId], references: [id])

  @@unique([companyId])
}

/// A metade de `config/client.ts` que NÃO pode ser a mesma para duas empresas
/// no mesmo banco: a marca e os módulos. Ciclo 1c
/// (`docs/superpowers/specs/2026-08-20-ciclo-1c-config-no-banco-design.md`,
/// seção 4).
///
/// **A linha é OPCIONAL, e isso é decisão do spec, não um `?` por descuido.**
/// Empresa sem linha usa os padrões do arquivo versionado — é o que resolve o
/// ovo-e-galinha do layout raiz, que envolve `/login`, onde ainda não existe
/// sessão e portanto não existe empresa. A leitura que materializa esse
/// fallback é a Task 3 deste mesmo ciclo (`src/core/config/leitura.ts`), em
/// cima da fusão pura da Task 2 (`src/core/config/schema.ts`, onde
/// `mesclarConfig` decide campo a campo quem vence); ela ainda NÃO existe
/// quando este bloco é escrito, então o parágrafo descreve contrato acordado,
/// não código medido.
///
/// **Colunas TIPADAS e não uma coluna `Json`.** A varredura de escopo recusa
/// `companyId` divergente em qualquer profundidade de `data`, inclusive dentro
/// de coluna `Json` — falso positivo DECLARADO em `src/core/tenancy/escopo.ts`
/// ("Falsos positivos conhecidos", nº 1), com caso de teste vivo em
/// `tests/unit/escopo-empresa.test.ts`. Um documento de configuração que um dia
/// ganhasse uma chave `companyId` (ou `company`, o outro nome que a varredura
/// persegue) seria recusado na escrita com uma mensagem sobre tenancy que não
/// tem relação com o defeito.
///
/// **Nulo significa "não decidi, usa o arquivo"** em `corPrimaria`, `fonte`,
/// `logoClaro` e `logoEscuro`. `modulos` não tem esse estado, e o motivo é do
/// Prisma: lista escalar é tipada `string[]`, não `string[] | null`
/// (`node_modules/.prisma/client/index.d.ts`, tipo `CompanyConfig`, conferido
/// depois de `prisma generate` nesta árvore) — ausência vira `[]`. Então a
/// regra dela é outra e vive na leitura da Task 2: se a linha existe, `modulos`
/// manda, inclusive vazia. Empresa que não decidiu módulos é empresa SEM LINHA.
///
/// `logoClaro` e `logoEscuro` são pensados como os dois ou nenhum — logo
/// monocromático some no fundo da mesma cor. A regra é cobrada na LEITURA (Task
/// 2), e não por `CHECK` no Postgres, por dois motivos: o Prisma não modela
/// `CHECK`, e o efeito de `prisma migrate dev` sobre um `CHECK` escrito à mão
/// (tratar como deriva e propor reset do banco) NÃO foi medido neste ambiente —
/// é NV2 do spec. Desenhar migração sobre comportamento não medido é o oposto
/// do que este programa faz.
model CompanyConfig {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  corPrimaria     String?
  fonte           String?
  logoClaro       String?
  logoEscuro      String?
  modulos         String[]
  atualizadoEm    DateTime @updatedAt
  atualizadoPorId String?
  atualizadoPor   User?    @relation("ConfigsEditadas", fields: [atualizadoPorId], references: [id])

  @@unique([companyId])
}

/**
 * Uma mensagem individual (recebida ou enviada) dentro de uma `Conversation`.
 * `idExterno` é o id que a Evolution atribui à mensagem (`data.key.id` no
 * payload do webhook) — é a chave de idempotência que faz uma redelivery do
 * mesmo webhook (retry da própria Evolution, ou reenvio manual) não duplicar
 * a mensagem no banco: `ingest.ts` trata a violação dessa constraint UNIQUE
 * exatamente como `encontrarOuCriarContact` trata a corrida em
 * `Contact.telefone` (core/leads/dedupe.ts) — "alguém já gravou isso,
 * devolve sem duplicar" em vez de deixar o erro cru do Postgres subir.
 * `processadoEm` marca quando esta mensagem ENTRADA foi incluída numa
 * resposta gerada por `turno.ts` — mensagens SAIDA já nascem com
 * `processadoEm` preenchido (não esperam processamento). É o que permite
 * `turno.ts` buscar exatamente as mensagens ainda não respondidas a cada
 * turno, mesmo quando várias chegaram fragmentadas antes do lease abrir.
 */
model WhatsappMessage {
  id             String          @id @default(cuid())
  companyId      String
  company        Company         @relation(fields: [companyId], references: [id])
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  idExterno      String          @unique
  direcao        WhatsappDirecao
  autor          WhatsappAutor
  tipo           WhatsappTipo
  texto          String?
  processadoEm   DateTime?
  criadoEm       DateTime        @default(now())

  // turno.ts filtra por (conversationId, direcao=ENTRADA, processadoEm=null)
  // a cada job — mesmo raciocínio do índice em Conversation.processandoAte.
  //
  // `companyId` NÃO entra como primeira coluna deste índice composto, e é
  // decisão, não esquecimento: toda chamada real (turno.ts) já filtra por
  // `conversationId`, uma FK de cardinalidade alta — cada conversa é UMA
  // linha de Conversation, então `conversationId` sozinho já é mais seletivo
  // do que `companyId` (que agrupa todas as conversas da empresa inteira)
  // poderia ser como prefixo. Prefixar com `companyId` aqui não serviria
  // nenhuma consulta existente, só engordaria o índice. `companyId` recebe o
  // índice PRÓPRIO abaixo — é o que serve uma futura consulta que filtre por
  // empresa sem passar por `conversationId`.
  @@index([conversationId, direcao, processadoEm])
  @@index([companyId])
}
